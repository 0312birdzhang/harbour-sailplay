<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.sailplay.Session1">
    <property name="Presentation" type="s" access="read"/>
    <property name="Active" type="b" access="read"/>
    <method name="GetSnapshot">
      <arg name="revision" type="t" direction="out"/>
      <arg name="state" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
    </method>
    <method name="SetActive">
      <arg name="active" type="b" direction="in"/>
    </method>
    <method name="Invoke">
      <arg name="requestId" type="t" direction="in"/>
      <arg name="action" type="s" direction="in"/>
      <arg name="parameters" type="a{sv}" direction="in"/>
      <arg name="expectedRevision" type="t" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
    </method>
    <method name="Close"/>
    <signal name="StateChanged">
      <arg name="revision" type="t"/>
      <arg name="state" type="a{sv}"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
    </signal>
    <signal name="RequestFinished">
      <arg name="requestId" type="t"/>
      <arg name="revision" type="t"/>
      <arg name="result" type="a{sv}"/>
      <arg name="errorName" type="s"/>
      <arg name="errorMessage" type="s"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out2" value="QVariantMap"/>
    </signal>
  </interface>
</node>
