[Unit]
Description=Sailplay wireless CarPlay
After=bluetooth.service connman.service
StartLimitIntervalSec=0
Wants=bluetooth.service connman.service

[Service]
Type=simple
Restart=always
RestartSec=2
ExecStart=/usr/bin/python3 /opt/sailplay/scripts/wireless-phone-advertise.py --seconds 0 --device /org/bluez/hci0/dev_EC_A7_AD_81_EA_86 --accessory-key /opt/sailplay/diagnostics/corolla-accessory-key.json --session-out /tmp/sailplay-session.json --announce-wireless --wifi-handover --sustained
KillMode=control-group
ExecStopPost=-/bin/sh -c '[ "$SERVICE_RESULT" = success ] && systemctl stop sailplay-handover-*.service || true'
ExecStopPost=-/bin/sh -c '[ "$SERVICE_RESULT" = success ] && /usr/bin/python3 /opt/sailplay/scripts/media-control.py --session-stop || true'
ExecStopPost=-/bin/sh -c '[ "$SERVICE_RESULT" = success ] && /usr/bin/su defaultuser -s /bin/sh -c "env XDG_RUNTIME_DIR=/run/user/100000 python3 /opt/sailplay/scripts/pulse-capture.py --restore-routing" || true'
ExecStopPost=-/usr/bin/python3 /opt/sailplay/scripts/stop-projected-apps.py
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
