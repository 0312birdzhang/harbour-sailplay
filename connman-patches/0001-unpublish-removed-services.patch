+/* The public path belongs to the registry entry, not its last reference.
+ * Async users may retain a removed service while a new network reuses its
+ * identifier. Unpublish immediately, and prevent its finalizer from later
+ * unregistering the replacement's interface.
+ */
+static void service_unregister(struct connman_service *service)
+{
+	char *path = service->path;
+
+	if (path) {
+		service->path = NULL;
+		__connman_connection_update_gateway();
+		g_dbus_unregister_interface(connection, path,
+						CONNMAN_SERVICE_INTERFACE);
+		g_free(path);
+	}
+}
