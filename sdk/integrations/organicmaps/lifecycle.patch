diff --git a/sailfish/sailplay_map_browser.cpp b/sailfish/sailplay_map_browser.cpp
new file mode 100644
index 00000000..abb1ecf6
--- /dev/null
+++ b/sailfish/sailplay_map_browser.cpp
@@ -0,0 +1,245 @@
+#include "sailfish/sailplay_map_browser.hpp"
+
+#include "sailfish/map_item.hpp"
+#include "sailfish/place_page.hpp"
+#include "sailfish/routing.hpp"
+
+#include <QSet>
+#include <QTextDocument>
+
+#include <algorithm>
+#include <stdexcept>
+
+namespace sailfish
+{
+namespace
+{
+int constexpr kPageSize = 40;
+
+QString Text(QString const & text)
+{
+  auto points = text.toUcs4();
+  points.erase(std::remove(points.begin(), points.end(), 0), points.end());
+  return QString::fromUcs4(points.constData(), std::min(512, points.size()));
+}
+
+QString PlainText(QVariant const & value)
+{
+  QTextDocument document;
+  document.setHtml(value.toString());
+  return Text(document.toPlainText());
+}
+
+void Fields(QVariantMap const & parameters, QStringList const & names)
+{
+  if (QSet<QString>::fromList(parameters.keys()) != QSet<QString>::fromList(names))
+    throw std::invalid_argument("Unexpected map browsing parameters");
+  for (auto const & name : names)
+  {
+    auto const value = parameters.value(name);
+    if (value.type() != QVariant::String || value.toString().contains(QChar::Null) ||
+        value.toString().toUcs4().size() > 256)
+      throw std::invalid_argument("Map browsing parameters must be bounded strings");
+  }
+}
+}  // namespace
+
+SailplayMapBrowser::SailplayMapBrowser(MapItem & map) : m_map(map)
+{
+  for (auto * model : {static_cast<QAbstractItemModel *>(&m_search), static_cast<QAbstractItemModel *>(&m_groups),
+                       static_cast<QAbstractItemModel *>(&m_bookmarks)})
+    connect(model, &QAbstractItemModel::modelReset, this, [this] { ++m_revision; });
+  connect(&m_search, &SearchModel::queryChanged, this, [this]
+  {
+    ++m_revision;
+    m_offset = 0;
+  });
+  connect(&m_search, &SearchModel::historyChanged, this, [this] { ++m_revision; });
+}
+
+void SailplayMapBrowser::SetPage(QString const & page)
+{
+  m_page = page;
+  m_offset = 0;
+  ++m_revision;
+}
+
+QVariantList SailplayMapBrowser::Rows() const
+{
+  if (m_cachedRevision == m_revision)
+    return m_cachedRows;
+  QVariantList rows;
+  auto const add = [&](int index, QString const & title, QString const & subtitle, QString const & kind,
+                       QString const & value = QString())
+  {
+    rows.append(QVariantMap{{"id", QString::number(m_revision) + '/' + QString::number(index)},
+                            {"title", Text(title)},
+                            {"subtitle", Text(subtitle)},
+                            {"kind", kind},
+                            {"value", value},
+                            {"index", index}});
+  };
+  if (m_page == "history")
+  {
+    auto const history = m_search.history();
+    for (int row = 0; row < history.size(); ++row)
+      add(row, history[row], {}, "query");
+  }
+  else if (m_page == "categories")
+  {
+    auto const categories = m_search.categories();
+    for (int row = 0; row < categories.size(); ++row)
+    {
+      auto const category = categories[row].toMap();
+      add(row, category.value("name").toString(), {}, "category");
+    }
+  }
+  else if (m_page == "search")
+  {
+    if (m_search.searching() || m_search.resultsQuery() != m_search.query())
+      return rows;
+    for (int row = 0; row < m_search.rowCount(); ++row)
+    {
+      auto const index = m_search.index(row);
+      QStringList detail;
+      for (int role : {SearchModel::DescriptionRole, SearchModel::AddressRole, SearchModel::DistanceRole})
+      {
+        auto const text = PlainText(m_search.data(index, role));
+        if (!text.isEmpty())
+          detail.append(text);
+      }
+      add(row, PlainText(m_search.data(index, SearchModel::NameRole)), detail.join(" · "),
+          m_search.data(index, SearchModel::SuggestRole).toBool() ? "suggestion" : "place");
+    }
+  }
+  else if (m_page == "bookmark-groups")
+  {
+    for (int row = 0; row < m_groups.rowCount(); ++row)
+    {
+      auto const index = m_groups.index(row);
+      int const count = m_groups.data(index, BookmarkCategoriesModel::BookmarksCountRole).toInt();
+      if (count > 0)
+        add(row, m_groups.data(index, BookmarkCategoriesModel::NameRole).toString(), QString::number(count), "group",
+            m_groups.data(index, BookmarkCategoriesModel::IdRole).toString());
+    }
+  }
+  else if (m_page == "bookmarks")
+  {
+    for (int row = 0; row < m_bookmarks.rowCount(); ++row)
+    {
+      auto const index = m_bookmarks.index(row);
+      if (m_bookmarks.data(index, BookmarksModel::IsTrackRole).toBool())
+        continue;
+      QStringList detail;
+      for (int role : {BookmarksModel::TypeRole, BookmarksModel::DistanceRole})
+      {
+        auto const text = m_bookmarks.data(index, role).toString();
+        if (!text.isEmpty())
+          detail.append(text);
+      }
+      add(row, m_bookmarks.data(index, BookmarksModel::NameRole).toString(), detail.join(" · "), "place");
+    }
+  }
+  m_cachedRows = rows;
+  m_cachedRevision = m_revision;
+  return rows;
+}
+
+QVariantMap SailplayMapBrowser::Snapshot() const
+{
+  auto const rows = Rows();
+  int const offset = rows.isEmpty() ? 0 : std::min(m_offset, (rows.size() - 1) / kPageSize * kPageSize);
+  QVariantList visible;
+  for (int row = offset; row < std::min(offset + kPageSize, rows.size()); ++row)
+    visible.append(rows[row]);
+  auto const * routing = m_map.routing();
+  return {{"page", m_page},
+          {"query", Text(m_search.query())},
+          {"title", Text(m_bookmarks.name())},
+          {"searching", m_page == "search" && (m_search.searching() || m_search.resultsQuery() != m_search.query())},
+          {"rows", visible},
+          {"previous", offset > 0},
+          {"next", offset + kPageSize < rows.size()},
+          {"routerType", routing->routerType()},
+          {"voiceEnabled", routing->voiceEnabled()},
+          {"voiceAvailable", routing->voiceAvailable()}};
+}
+
+void SailplayMapBrowser::Select(QString const & id)
+{
+  auto const rows = Rows();
+  auto const found = std::find_if(rows.begin(), rows.end(),
+                                  [&](QVariant const & value) { return value.toMap().value("id").toString() == id; });
+  if (found == rows.end())
+    throw std::invalid_argument("The destination list has changed. Select its current item");
+  auto const row = found->toMap();
+  int const index = row.value("index").toInt();
+  if (m_page == "history" || m_page == "categories")
+  {
+    if (m_page == "categories")
+      m_search.searchCategory(m_search.categories().value(index).toMap().value("name").toString());
+    else
+      m_search.setQuery(m_search.history().value(index));
+    SetPage("search");
+  }
+  else if (m_page == "bookmark-groups")
+  {
+    m_bookmarks.setListId(row.value("value").toULongLong());
+    SetPage("bookmarks");
+  }
+  else if (m_page == "bookmarks")
+  {
+    m_bookmarks.showOnMap(index);
+    SetPage({});
+  }
+  else if (m_search.activate(index))
+    SetPage({});
+}
+
+void SailplayMapBrowser::Invoke(QVariantMap const & parameters)
+{
+  auto const command = parameters.value("command").toString();
+  if (command == "search")
+  {
+    Fields(parameters, {"command", "query"});
+    m_search.setQuery(parameters.value("query").toString());
+    SetPage("search");
+  }
+  else if (command == "select")
+  {
+    Fields(parameters, {"command", "id"});
+    Select(parameters.value("id").toString());
+  }
+  else
+  {
+    Fields(parameters, {"command"});
+    if (QStringList{"history", "categories", "bookmark-groups", "settings"}.contains(command))
+      SetPage(command);
+    else if (command == "close")
+      SetPage({});
+    else if (command == "next" || command == "previous")
+    {
+      auto const state = Snapshot();
+      if (!state.value(command).toBool())
+        throw std::invalid_argument("Destination page is unavailable");
+      int const count = Rows().size();
+      m_offset = std::min(m_offset, std::max(0, (count - 1) / kPageSize * kPageSize));
+      m_offset += command == "next" ? kPageSize : -kPageSize;
+    }
+    else if (command == "mute")
+      m_map.routing()->setVoiceEnabled(!m_map.routing()->voiceEnabled());
+    else if (command == "clear-place")
+      m_map.placePage()->close();
+    else if (command == "toggle-bookmark")
+    {
+      if (!m_map.placePage()->open())
+        throw std::invalid_argument("Select a place before saving a bookmark");
+      m_map.placePage()->toggleBookmark();
+    }
+    else if (QStringList{"vehicle", "walking", "cycling"}.contains(command))
+      m_map.routing()->setRouterType(QStringList{"vehicle", "walking", "cycling"}.indexOf(command));
+    else
+      throw std::invalid_argument("Unknown map browsing command");
+  }
+}
+}  // namespace sailfish
diff --git a/sailfish/sailplay_map_browser.hpp b/sailfish/sailplay_map_browser.hpp
new file mode 100644
index 00000000..21922d1d
--- /dev/null
+++ b/sailfish/sailplay_map_browser.hpp
@@ -0,0 +1,34 @@
+#pragma once
+
+#include "sailfish/bookmarks_model.hpp"
+#include "sailfish/search_model.hpp"
+
+#include <QVariantMap>
+
+namespace sailfish
+{
+class MapItem;
+
+class SailplayMapBrowser : public QObject
+{
+public:
+  explicit SailplayMapBrowser(MapItem & map);
+  QVariantMap Snapshot() const;
+  void Invoke(QVariantMap const & parameters);
+
+private:
+  void Select(QString const & id);
+  void SetPage(QString const & page);
+  QVariantList Rows() const;
+
+  MapItem & m_map;
+  SearchModel m_search;
+  BookmarkCategoriesModel m_groups;
+  BookmarksModel m_bookmarks;
+  QString m_page;
+  uint64_t m_revision = 1;
+  mutable uint64_t m_cachedRevision = 0;
+  mutable QVariantList m_cachedRows;
+  int m_offset = 0;
+};
+}  // namespace sailfish
diff --git a/sailfish/sailplay_map_canvas.cpp b/sailfish/sailplay_map_canvas.cpp
new file mode 100644
index 00000000..ddb3bd1a
--- /dev/null
+++ b/sailfish/sailplay_map_canvas.cpp
@@ -0,0 +1,173 @@
+#include "sailfish/sailplay_map_canvas.hpp"
+
+#include "sailfish/map_item.hpp"
+#include "sailfish/phone_presentation.hpp"
+#include "sailfish/place_page.hpp"
+#include "sailfish/routing.hpp"
+
+#include <QBuffer>
+#include <QOffscreenSurface>
+#include <QOpenGLContext>
+#include <QQuickWindow>
+
+#include <stdexcept>
+
+namespace sailfish
+{
+SailplayMapCanvas::SailplayMapCanvas(MapItem & map, PhonePresentation & phone, QObject * parent)
+  : QObject(parent)
+  , m_map(map)
+  , m_phone(phone)
+{
+  m_expiry.setInterval(1000);
+  connect(&m_expiry, &QTimer::timeout, this, [this]
+  {
+    if (m_lastRequest.isValid() && m_lastRequest.elapsed() > 2500)
+      Release();
+  });
+  connect(&m_phone, &PhonePresentation::changed, this, [this]
+  {
+    if (m_touching)
+      m_map.CarTouch(QStringLiteral("cancel"), 0, 0);
+    m_touching = false;
+    m_image.clear();
+    m_sourceViewport = {};
+    if (m_lastRequest.isValid() && m_lastRequest.elapsed() <= 2500)
+      Attach();
+  });
+}
+
+SailplayMapCanvas::~SailplayMapCanvas()
+{
+  Release();
+}
+
+void SailplayMapCanvas::Attach()
+{
+  m_map.SetCarViewActive(true);
+  if (m_phone.isOpen())
+  {
+    m_window.reset();
+    return;
+  }
+  if (!m_window)
+  {
+    m_window = std::make_unique<QQuickWindow>();
+    m_window->setSurfaceType(QSurface::OpenGLSurface);
+  }
+  m_window->setGeometry(0, 0, m_size.width(), m_size.height());
+  m_map.setViewportBottomInset(0);
+  m_map.setLeftInset(0);
+  m_map.setRightInset(0);
+  m_map.setBottomWidgetsOffset(0);
+  m_map.setTopWidgetsOffset(0);
+  if (QSizeF(m_map.width(), m_map.height()) != QSizeF(m_size))
+    m_map.setSize(m_size);
+  if (m_map.parentItem() != m_window->contentItem())
+    m_map.setParentItem(m_window->contentItem());
+}
+
+void SailplayMapCanvas::Release()
+{
+  if (m_touching)
+    m_map.CarTouch(QStringLiteral("cancel"), 0, 0);
+  m_touching = false;
+  m_map.SetCarViewActive(false);
+  if (m_window && m_map.window() == m_window.get())
+    m_map.setParentItem(nullptr);
+  m_window.reset();
+  m_context.reset();
+  m_surface.reset();
+  m_image.clear();
+  m_imageSize = {};
+  m_sourceViewport = {};
+  m_lastRequest.invalidate();
+  m_expiry.stop();
+}
+
+QVariantMap SailplayMapCanvas::Frame(QSize const & size)
+{
+  if (size != m_size)
+  {
+    if (m_touching)
+      m_map.CarTouch(QStringLiteral("cancel"), 0, 0);
+    m_touching = false;
+    m_image.clear();
+    m_sourceViewport = {};
+  }
+  m_size = size;
+  m_lastRequest.restart();
+  m_expiry.start();
+  Attach();
+  if (!m_context)
+  {
+    auto * shared = QOpenGLContext::globalShareContext();
+    if (!shared)
+      throw std::runtime_error("Map OpenGL sharing is unavailable");
+    auto surface = std::make_unique<QOffscreenSurface>(shared->screen());
+    surface->setFormat(shared->format());
+    surface->create();
+    auto context = std::make_unique<QOpenGLContext>();
+    context->setFormat(shared->format());
+    context->setShareContext(shared);
+    if (!context->create() || !surface->isValid())
+      throw std::runtime_error("Map readback context creation failed");
+    m_surface = std::move(surface);
+    m_context = std::move(context);
+  }
+  uint64_t const number = m_map.CarFrameNumber();
+  if (number != m_frame || m_image.isEmpty())
+  {
+    if (!m_context->makeCurrent(m_surface.get()))
+      throw std::runtime_error("Map readback context binding failed");
+    QImage image = m_map.CaptureCarFrame(*m_context->functions());
+    m_context->doneCurrent();
+    if (!image.isNull())
+    {
+      // The shared phone view can have a different aspect ratio. Keep the car
+      // viewport and its touch mapping together while the phone stays open.
+      qreal const scale = qMax(qreal(m_size.width()) / image.width(), qreal(m_size.height()) / image.height());
+      QSize const cropSize(qBound(1, qRound(m_size.width() / scale), image.width()),
+                           qBound(1, qRound(m_size.height() / scale), image.height()));
+      QRect const crop((image.width() - cropSize.width()) / 2, (image.height() - cropSize.height()) / 2,
+                       cropSize.width(), cropSize.height());
+      QRectF const viewport(qreal(crop.x()) / image.width(), qreal(crop.y()) / image.height(),
+                            qreal(crop.width()) / image.width(), qreal(crop.height()) / image.height());
+      image = image.copy(crop).scaled(m_size, Qt::IgnoreAspectRatio, Qt::SmoothTransformation);
+      QByteArray encoded;
+      QBuffer buffer(&encoded);
+      buffer.open(QIODevice::WriteOnly);
+      if (!image.save(&buffer, "JPEG", 85) || encoded.size() > 4 * 1024 * 1024)
+        throw std::runtime_error("Map image encoding failed");
+      m_frame = number;
+      m_image = encoded;
+      m_imageSize = image.size();
+      m_sourceViewport = viewport;
+    }
+  }
+  auto const * routing = m_map.routing();
+  QVariantMap const state = {{"place", m_map.placePage()->open() ? m_map.placePage()->title().left(1024) : QString()},
+                             {"bookmarked", m_map.placePage()->open() && m_map.placePage()->isBookmark()},
+                             {"building", routing->building()},
+                             {"built", routing->built()},
+                             {"canStart", routing->canStart()},
+                             {"disclaimerAccepted", routing->disclaimerAccepted()},
+                             {"summary", routing->summary().left(1024)},
+                             {"waitingForPosition", routing->waitingForPosition()},
+                             {"error", routing->errorTitle().left(1024)}};
+  return {{"image", m_image}, {"width", m_imageSize.width()}, {"height", m_imageSize.height()}, {"state", state}};
+}
+
+void SailplayMapCanvas::Touch(QString const & phase, double x, double y)
+{
+  if (!m_lastRequest.isValid() || m_sourceViewport.isEmpty())
+    return;
+  if (phase == QStringLiteral("press"))
+    m_touching = true;
+  if (m_touching)
+    m_map.CarTouch(phase, m_sourceViewport.x() + x * m_sourceViewport.width(),
+                   m_sourceViewport.y() + y * m_sourceViewport.height());
+  if (phase == QStringLiteral("release") || phase == QStringLiteral("cancel"))
+    m_touching = false;
+}
+}  // namespace sailfish
