if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
  get_property(armed GLOBAL PROPERTY SAILPLAY_CORE_TEST_HOOK)
  if(NOT armed)
    set_property(GLOBAL PROPERTY SAILPLAY_CORE_TEST_HOOK TRUE)
    set_property(GLOBAL PROPERTY SAILPLAY_CORE_TEST_FILE "${CMAKE_CURRENT_LIST_DIR}/map_core_tests.cmake")
    function(sailplay_add_core_tests)
      get_property(test_file GLOBAL PROPERTY SAILPLAY_CORE_TEST_FILE)
      include("${test_file}")
    endfunction()
    cmake_language(DEFER CALL sailplay_add_core_tests)
  endif()
endif()
