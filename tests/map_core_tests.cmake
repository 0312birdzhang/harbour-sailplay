find_package(Qt5 REQUIRED COMPONENTS Widgets Positioning DBus Gui Qml Quick Sensors)
# Test-only alias: upstream test harness names Qt6 but its event loop uses QtCore APIs supported by Qt5.
add_library(Qt6::Widgets ALIAS Qt5::Widgets)
set(support_dir "${OMIM_ROOT}/libs/platform/platform_tests_support")
add_library(platform_tests_support STATIC
  "${support_dir}/helpers.cpp" "${support_dir}/scoped_dir.cpp"
  "${support_dir}/scoped_file.cpp" "${support_dir}/scoped_mwm.cpp"
  "${support_dir}/test_socket.cpp" "${support_dir}/writable_dir_changer.cpp")
target_include_directories(platform_tests_support PRIVATE ${OMIM_INCLUDE_DIRS})
target_link_libraries(platform_tests_support PUBLIC platform indexer)
omim_add_test_target(sailplay_core_async "libs/routing/routing_tests/async_router_test.cpp;libs/routing/routing_tests/tools.cpp" FALSE FALSE FALSE FALSE)
target_link_libraries(sailplay_core_async PRIVATE platform_tests_support routing storage)
omim_add_test_target(sailplay_core_blake3 "libs/coding/coding_tests/blake3_test.cpp" FALSE FALSE FALSE FALSE)
target_link_libraries(sailplay_core_blake3 PRIVATE platform_tests_support coding)
omim_add_test_target(sailplay_core_storage "libs/storage/storage_tests/storage_download_tests.cpp;libs/storage/storage_tests/test_map_files_downloader.cpp" FALSE TRUE FALSE FALSE)
target_link_libraries(sailplay_core_storage PRIVATE platform_tests_support storage)
omim_add_test_target(sailplay_core_routes "libs/map/map_tests/routing_manager_tests.cpp" FALSE TRUE FALSE FALSE)
target_link_libraries(sailplay_core_routes PRIVATE platform_tests_support map)
omim_add_test_target(sailplay_core_position "libs/map/map_tests/framework_location_tests.cpp" FALSE TRUE FALSE FALSE)
target_link_libraries(sailplay_core_position PRIVATE platform_tests_support map)

add_executable(sailplay_core_location ${CMAKE_CURRENT_LIST_DIR}/map_location_lifecycle_probe.cpp)
target_include_directories(sailplay_core_location PRIVATE ${OMIM_INCLUDE_DIRS})
target_link_libraries(sailplay_core_location PRIVATE location_service platform Qt5::Positioning Qt5::Core)

# Compile the production Sailfish bridge into a fixture with an isolated backend owner.
get_target_property(map_backend_sources organicmaps_sailfish_lib SOURCES)
list(REMOVE_ITEM map_backend_sources app.cpp)
set(map_backend_test_sources)
foreach(source IN LISTS map_backend_sources)
  if(NOT IS_ABSOLUTE "${source}")
    set(source "${OMIM_ROOT}/sailfish/${source}")
  endif()
  list(APPEND map_backend_test_sources "${source}")
endforeach()
get_target_property(map_backend_libraries organicmaps_sailfish_lib LINK_LIBRARIES)
get_target_property(map_backend_includes organicmaps_sailfish_lib INCLUDE_DIRECTORIES)
get_target_property(map_backend_definitions organicmaps_sailfish_lib COMPILE_DEFINITIONS)
add_library(sailplay_map_lifecycle_lib SHARED ${CMAKE_CURRENT_LIST_DIR}/map_backend_lifecycle_probe.cpp ${map_backend_test_sources})
set_target_properties(sailplay_map_lifecycle_lib PROPERTIES AUTOMOC ON OUTPUT_NAME sailplay_map_lifecycle)
target_include_directories(sailplay_map_lifecycle_lib PRIVATE ${map_backend_includes})
target_compile_definitions(sailplay_map_lifecycle_lib PRIVATE ${map_backend_definitions})
target_link_options(sailplay_map_lifecycle_lib PRIVATE -Wl,--exclude-libs,ALL)
target_link_libraries(sailplay_map_lifecycle_lib PRIVATE ${map_backend_libraries})
# Keep application TLS in a shared library, matching the libhybris-compatible production launcher.
add_executable(sailplay_map_lifecycle "${OMIM_ROOT}/sailfish/main.cpp")
set_target_properties(sailplay_map_lifecycle PROPERTIES BUILD_RPATH "$ORIGIN")
target_link_options(sailplay_map_lifecycle PRIVATE -Wl,--disable-new-dtags -Wl,--export-dynamic)
target_link_libraries(sailplay_map_lifecycle PRIVATE sailplay_map_lifecycle_lib)
